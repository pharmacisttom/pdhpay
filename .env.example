# ==============================================================================
# PDHPAY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT NOTE ON NEXT_PUBLIC_* VARIABLES:
# Variables starting with NEXT_PUBLIC_* are embedded into the client-side JavaScript bundle
# during BUILD time (npm run build). Therefore, when building Docker image for Production,
# make sure NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_API_URL are set to the actual Production domain!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Embedded into client JS at build time)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://pdhpay.pluakdaenghospital.cloud"
NEXT_PUBLIC_API_URL="https://pdhpay.pluakdaenghospital.cloud/api/v1"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Never exposed to browser client)
# ------------------------------------------------------------------------------
# Environment & App Settings
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Database Credentials & Host Settings
DB_HOST="mysql"
DB_PORT="3306"
DB_USER="pdh_user"
DB_PASSWORD="YourStrongSecurePassword123!"
DB_NAME="pdhpay"
DATABASE_URL="mysql://pdh_user:YourStrongSecurePassword123!@mysql:3306/pdhpay"

# Security Secrets & Encryption Keys (Generate via: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_STRING_32_BYTES"
JWT_SECRET="CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_STRING_32_BYTES"
TOTP_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTES_KEY=="

# Organization Seeding (First-time initialization)
SEED_ORGANIZATION="pdh"
SEED_ADMIN_EMAIL="admin@pdhpay.com"
SEED_ADMIN_PASSWORD="@Pdhpay10832"

# Google Drive Storage & OCR Configuration
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1ljSm9X79onx1bjnkdn41E0x4SfjZskjC"
GOOGLE_SHARED_DRIVE_ID=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_RANGE="Payments!A:K"
GOOGLE_VISION_ENABLED="false"
