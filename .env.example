DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tomvis_core
AUTH_SECRET=
TOTP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
NODE_ENV=development
BUILD_ID=local
SEED_ORGANIZATION=pdh-dev
# Development only. Supply email and a strong password; reruns preserve passwords.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payment storage (Phase 5; server-side only, never NEXT_PUBLIC_*)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Optional when the folder is inside a Shared Drive.
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_SHEET_ID=
# Default: Payments!A:K
GOOGLE_SHEET_RANGE=Payments!A:K
# Optional OCR; uses the same service account credentials and requires Cloud Vision API.
GOOGLE_VISION_ENABLED=false
