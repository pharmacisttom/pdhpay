{
  "name": "tomvis-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "prisma generate && next build",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "docker:build": "docker build -t pdhpay:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production pdhpay:latest",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:provision-test-users": "tsx scripts/provision-test-users.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts"
  },
  "engines": {
    "node": ">=22.17.0 <23 || >=24"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "otpauth": "9.5.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "sweetalert2": "11.26.25",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "type": "module",
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
